# 本文件只用于 Docker Compose 语音容器，不会被 Java 自动读取。
# 复制为根目录 .env 后生效；.env 已被 Git 忽略。

# 当前受支持的跨平台配置：CPU + faster-whisper small + int8。
SPEECH_ASR_MODEL=small
SPEECH_ASR_DEVICE=cpu
SPEECH_ASR_COMPUTE_TYPE=int8
SPEECH_ASR_LANGUAGE=zh
SPEECH_ASR_MAX_CONCURRENCY=1

# Edge-TTS 在线中文音色与语速。
SPEECH_TTS_VOICE=zh-CN-XiaoxiaoNeural
SPEECH_TTS_RATE=+0%
SPEECH_TTS_VOLUME=+0%
SPEECH_TTS_PITCH=+0Hz

# 网络可直接访问 Hugging Face 时保留下面两项默认值。
SPEECH_HF_ENDPOINT=https://huggingface.co
SPEECH_ASR_MODEL_BASE_URL=

# 如果 Hugging Face 下载长期无进度，可改为以下镜像地址；镜像属于第三方服务。
# SPEECH_HF_ENDPOINT=https://hf-mirror.com
# SPEECH_ASR_MODEL_BASE_URL=https://hf-mirror.com/Systran/faster-whisper-small/resolve/main
