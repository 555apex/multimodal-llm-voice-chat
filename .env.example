# 本文件只用于 Docker Compose 语音容器，不会被 Java 自动读取。
# 复制为根目录 .env 后生效；.env 已被 Git 忽略。

# 模型目录由 deploy/dgx/download-speech-models 下载并只读挂载。
SPEECH_MODEL_ROOT=./speech-service/models
SPEECH_ASR_MODEL=small
SPEECH_ASR_MODEL_PATH=/models/Systran--faster-whisper-small
SPEECH_ASR_DEVICE=cpu
SPEECH_ASR_COMPUTE_TYPE=int8
SPEECH_ASR_LANGUAGE=zh
SPEECH_ASR_MAX_CONCURRENCY=1

# Qwen3-TTS 完全本地推理；Serena 是中文女声。
SPEECH_TTS_MODEL_PATH=/models/Qwen--Qwen3-TTS-12Hz-0.6B-CustomVoice
SPEECH_TTS_VOICE=Serena
SPEECH_TTS_LANGUAGE=Chinese
SPEECH_TTS_DEVICE=cuda:0
SPEECH_TTS_DTYPE=bfloat16
SPEECH_TTS_MAX_CONCURRENCY=1
SPEECH_TTS_RATE=+0%
SPEECH_TTS_VOLUME=+0%
SPEECH_TTS_PITCH=+0Hz

# DGX ARM64/GB10 使用的 NVIDIA PyTorch 基础镜像。
SPEECH_BASE_IMAGE=nvcr.io/nvidia/pytorch@sha256:d724ba5b68075cd3b96eefbc510a45d36e60dd16fd70b217708625f1f4b37bc1
