# Copy this file to deploy/dgx/.env and set only the secrets marked REQUIRED.
# Never commit the resulting .env file.

# REQUIRED: existing shared MySQL configuration.
ROADAGENT_DB_URL=
ROADAGENT_DB_USERNAME=
ROADAGENT_DB_PASSWORD=

# MySQL traffic snapshots.
ROADAGENT_TRAFFIC_SNAPSHOT_POLL_SECONDS=5
ROADAGENT_TRAFFIC_SNAPSHOT_STABLE_SECONDS=30

# Agent model: existing DGX Qwen vLLM service.
ROADAGENT_MODEL_PROVIDER=openai-compatible
ROADAGENT_MODEL_ENDPOINT=http://qwen:8000/v1/chat/completions
ROADAGENT_MODEL_NAME=qwen3.6-35b-a3b-nvfp4
ROADAGENT_MODEL_AUTH_ENABLED=false
ROADAGENT_MODEL_ENABLE_THINKING=false
ROADAGENT_MODEL_TIMEOUT_SECONDS=60

# Local speech models, mounted read-only from /home/whtc/models.
SPEECH_ASR_MODEL=small
SPEECH_ASR_MODEL_PATH=/models/Systran--faster-whisper-small
SPEECH_ASR_DEVICE=cpu
SPEECH_ASR_COMPUTE_TYPE=int8
SPEECH_ASR_LANGUAGE=zh
SPEECH_ASR_MAX_CONCURRENCY=1
SPEECH_TTS_MODEL_PATH=/models/Qwen--Qwen3-TTS-12Hz-0.6B-CustomVoice
SPEECH_TTS_VOICE=Serena
SPEECH_TTS_LANGUAGE=Chinese
SPEECH_TTS_DEVICE=cuda:0
SPEECH_TTS_DTYPE=bfloat16
SPEECH_TTS_MAX_CONCURRENCY=2
SPEECH_TTS_ENGINE=vllm-omni
SPEECH_TTS_SERVICE_URL=http://tts-omni-candidate:8091
SPEECH_TTS_SERVICE_MODEL=/models/Qwen--Qwen3-TTS-12Hz-1.7B-CustomVoice
SPEECH_TTS_API_KEY=EMPTY
SPEECH_TTS_SAMPLE_RATE=24000
SPEECH_MAX_AUDIO_BYTES=10485760
SPEECH_MAX_TTS_CHARACTERS=500

# Verified ARM64 image manifest. The tag is kept in the comment for traceability.
# nvcr.io/nvidia/pytorch:25.08-py3 (linux/arm64, CUDA 13.0, driver >= 575)
SPEECH_BASE_IMAGE=nvcr.io/nvidia/pytorch@sha256:d724ba5b68075cd3b96eefbc510a45d36e60dd16fd70b217708625f1f4b37bc1

# Deployed release images. Compose reads the running image from these variables,
# so they MUST match the images actually deployed. If they drift from what is
# running, a plain `docker compose up` silently reverts the service to the older
# tag. Update them whenever a release is switched.
ROADAGENT_BACKEND_IMAGE=road-agent-dgx-backend:tts-20260915
ROADAGENT_FRONTEND_IMAGE=road-agent-dgx-frontend:tts-20260915
ROADAGENT_SPEECH_IMAGE=road-agent-dgx-speech:tts-20260915-r2

# Docker Hub is not directly reachable from this DGX; use the verified proxy.
JAVA_BUILD_IMAGE=dockerproxy.net/library/eclipse-temurin:17-jdk-jammy
JAVA_RUNTIME_IMAGE=dockerproxy.net/library/eclipse-temurin:17-jre-jammy
NODE_BUILD_IMAGE=dockerproxy.net/library/node:22-bookworm-slim
NGINX_IMAGE=dockerproxy.net/nginxinc/nginx-unprivileged:1.29-alpine

# Deployment-time database client only; not part of the running application stack.
MYSQL_CLIENT_IMAGE=dockerproxy.net/library/mysql:8.4.11-oraclelinux9
