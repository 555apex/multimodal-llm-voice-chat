#!/usr/bin/env python3
"""Download immutable speech snapshots and write auditable manifests."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path

from huggingface_hub import snapshot_download


MODELS = (
    {
        "name": "faster-whisper-small",
        "repo_id": "Systran/faster-whisper-small",
        "revision": "536b0662742c02347bc0e980a01041f333bce120",
        "license": "MIT",
        "directory": "Systran--faster-whisper-small",
    },
    {
        "name": "qwen3-tts-0.6b-custom-voice",
        "repo_id": "Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice",
        "revision": "f3d1af06e4eaefac12b1ffa6726f9eef674a6f02",
        "license": "Apache-2.0",
        "directory": "Qwen--Qwen3-TTS-12Hz-0.6B-CustomVoice",
    },
)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def manifest_files(directory: Path) -> list[dict[str, object]]:
    result: list[dict[str, object]] = []
    for path in sorted(directory.rglob("*")):
        if not path.is_file() or ".cache" in path.parts or path.name == ".deployment-manifest.json":
            continue
        result.append(
            {
                "path": path.relative_to(directory).as_posix(),
                "size": path.stat().st_size,
                "sha256": sha256(path),
            }
        )
    return result


def verify(directory: Path, model: dict[str, str]) -> bool:
    manifest_path = directory / ".deployment-manifest.json"
    if not manifest_path.is_file():
        return False
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("repo_id") != model["repo_id"] or manifest.get("revision") != model["revision"]:
        return False
    for item in manifest.get("files", []):
        path = directory / item["path"]
        if not path.is_file() or path.stat().st_size != item["size"] or sha256(path) != item["sha256"]:
            return False
    return bool(manifest.get("files"))


def download(root: Path, model: dict[str, str], verify_only: bool) -> None:
    directory = root / model["directory"]
    if verify(directory, model):
        print(f"verified: {model['repo_id']}@{model['revision']}")
        return
    if verify_only:
        raise RuntimeError(f"model is missing or invalid: {directory}")
    directory.mkdir(parents=True, exist_ok=True)
    snapshot_download(
        repo_id=model["repo_id"],
        revision=model["revision"],
        local_dir=str(directory),
    )
    files = manifest_files(directory)
    if not files:
        raise RuntimeError(f"download produced no files: {directory}")
    manifest = {
        "name": model["name"],
        "repo_id": model["repo_id"],
        "revision": model["revision"],
        "license": model["license"],
        "downloaded_at": datetime.now(timezone.utc).isoformat(),
        "hf_endpoint": os.getenv("HF_ENDPOINT", "https://huggingface.co"),
        "files": files,
    }
    temporary = directory / ".deployment-manifest.json.tmp"
    temporary.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temporary.replace(directory / ".deployment-manifest.json")
    if not verify(directory, model):
        raise RuntimeError(f"post-download verification failed: {directory}")
    print(f"downloaded and verified: {model['repo_id']}@{model['revision']}")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path("/models"))
    parser.add_argument("--verify-only", action="store_true")
    args = parser.parse_args()
    args.root.mkdir(parents=True, exist_ok=True)
    for model in MODELS:
        download(args.root, model, args.verify_only)


if __name__ == "__main__":
    main()
