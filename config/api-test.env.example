# 这是环境变量示例，不要在本文件填写或提交真实密钥。

# 当前交通数据只使用高德真实API
export ROADAGENT_TRAFFIC_PROVIDER=amap

# 在本机复制本文件为config/api-test.env，再填写自己的新Key
export AMAP_API_KEY=replace-with-your-new-amap-web-key

# 区域查询可选调整：默认6公里分片、最多500片、并发4个
# export AMAP_AREA_TILE_SIZE_KM=6
# export AMAP_AREA_MAX_TILES=500
# export AMAP_AREA_CONCURRENCY=4
# export AMAP_AREA_CACHE_SECONDS=120

# DeepSeek负责意图识别、方案生成和流式回答
export ROADAGENT_MODEL_PROVIDER=openai-compatible
export ROADAGENT_MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
export ROADAGENT_MODEL_API_KEY=replace-with-your-new-deepseek-key
export ROADAGENT_MODEL_NAME=deepseek-v4-flash
export ROADAGENT_MODEL_AUTH_ENABLED=true

# MySQL数据库。复制到本地配置后，将地址、账号和密码替换为实际值
export ROADAGENT_DB_URL='jdbc:mysql://database-host:3306/road_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai'
export ROADAGENT_DB_USERNAME=replace-with-database-user
export ROADAGENT_DB_PASSWORD=replace-with-database-password

# 无Bearer鉴权的服务器模型只需修改地址、模型名并设置为false
# export ROADAGENT_MODEL_ENDPOINT=http://server-model/v1/chat/completions
# export ROADAGENT_MODEL_NAME=your-local-model
# export ROADAGENT_MODEL_AUTH_ENABLED=false
