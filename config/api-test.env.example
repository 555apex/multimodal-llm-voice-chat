# 这是环境变量示例，不要在本文件填写或提交真实密钥。

# 交通数据：mock 或 amap
export ROADAGENT_TRAFFIC_PROVIDER=mock
export ROADAGENT_MOCK_SCENARIO=normal

# 如果测试高德，将上面的provider改成amap并在本机终端填写Key
export AMAP_API_KEY=replace-with-your-amap-web-key

# 摘要：rule 或 openai-compatible
export ROADAGENT_MODEL_PROVIDER=rule
export ROADAGENT_MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
export ROADAGENT_MODEL_API_KEY=replace-with-your-deepseek-key
export ROADAGENT_MODEL_NAME=deepseek-v4-flash
