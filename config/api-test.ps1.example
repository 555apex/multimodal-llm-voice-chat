# 复制本文件为 config/api-test.ps1，再填写协作者自己的 API Key 和负责人提供的数据库信息。
# config/api-test.ps1 已被 Git 忽略，不要在本示例文件中填写真实密钥。

# 交通数据只从MySQL读取，不需要地图API Key。
# 下列快照参数仅用于路况/通行能力；区域压力、车型分析及OD按请求读取。
# $env:ROADAGENT_TRAFFIC_SNAPSHOT_POLL_SECONDS = '5'
# $env:ROADAGENT_TRAFFIC_SNAPSHOT_STABLE_SECONDS = '30'

# DeepSeek 负责意图识别、方案生成和流式回答。
$env:ROADAGENT_MODEL_PROVIDER = 'openai-compatible'
$env:ROADAGENT_MODEL_ENDPOINT = 'https://api.deepseek.com/chat/completions'
$env:ROADAGENT_MODEL_API_KEY = 'replace-with-your-own-deepseek-key'
$env:ROADAGENT_MODEL_NAME = 'deepseek-v4-flash'
$env:ROADAGENT_MODEL_AUTH_ENABLED = 'true'

# 云 MySQL 信息由项目负责人通过安全渠道提供。
$env:ROADAGENT_DB_URL = 'jdbc:mysql://database-host:3306/road_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai'
$env:ROADAGENT_DB_USERNAME = 'replace-with-database-user'
$env:ROADAGENT_DB_PASSWORD = 'replace-with-database-password'

# Java 通过 HTTP 调用 Docker 语音容器；容器离线不会阻止后端启动。
$env:ROADAGENT_SPEECH_ENABLED = 'true'
$env:ROADAGENT_SPEECH_SERVICE_URL = 'http://localhost:8091'
