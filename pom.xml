<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. 基础信息 -->
    <groupId>cn.fj.roadagent</groupId>         <!-- 组织域名 -->
    <artifactId>roadagent-parent</artifactId>  <!-- 项目唯一ID -->
    <version>0.1.0-SNAPSHOT</version>   <!-- 版本号 -->
    <packaging>pom</packaging>  <!-- 打包方式(默认jar，还有pom、war等) -->

    <!-- 2. 元信息 -->
    <name>福建应急交通 Agent</name>   <!-- 项目名称 -->
    <!-- url:<url>https://example.com</url>  可选 -->
    <description>交通查询工作流教学型项目骨架</description>

    <!-- maven子模块管理说明 -->
    <modules>
        <module>road-agent-domain</module>
        <module>road-agent-application</module>
        <module>road-agent-core</module>
        <module>road-agent-adapters</module>
        <module>road-agent-interface</module>
        <module>road-agent-boot</module>
    </modules>

    <!-- 3. 环境配置 -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.5.14</spring-boot.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    </properties>

    <!-- 4. 依赖管理 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 5. 构建配置 -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
