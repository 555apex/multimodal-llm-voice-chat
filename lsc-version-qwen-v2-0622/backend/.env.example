# DashScope 百炼 API Key（从 https://bailian.console.aliyun.com 获取）
DASHSCOPE_API_KEY=sk-your-api-key-here

# LLM 模型选择（可选: qwen-turbo, qwen-plus, qwen-max, deepseek-v3, deepseek-r1）
DASHSCOPE_LLM_MODEL=qwen-plus

# 本地 Whisper 模型大小（可选: tiny, base, small, medium, large-v3）
WHISPER_MODEL_SIZE=small

# Flask 配置
SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=True
PORT=5000
