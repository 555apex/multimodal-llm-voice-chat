# LLM API 配置
# 支持: deepseek / mimo / 其他 OpenAI 兼容 API
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# DeepSeek 可用模型:
# - deepseek-chat (通用对话)
# - deepseek-coder (代码专用)
# - deepseek-reasoning (推理专用)

# mimo 配置 (可选)
# MIMO_API_KEY=your-mimo-api-key
# LLM_API_BASE_URL=https://api.xiaomimimo.com/v1
# LLM_MODEL=mimo-v2.5-pro

# Flask 配置
SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=True
PORT=5000

# 模型缓存路径
MODEL_CACHE_DIR=D:\funasr_chattts

# ASR 配置
ASR_MODEL=iic/speech_paraformer-large-vad-punc_asr_nat-zh-cn-16k-common-vocab8404-pytorch
ASR_DEVICE=cuda

# TTS 配置
TTS_MODEL=2Noise/ChatTTS
TTS_DEVICE=cuda
